# FluxGate Performance Test Environment Variables
# Copy this file to .env and customize as needed

# Database Configuration
DB_PASSWORD=root123
DB_NAME=feature_toggle

# Logging Levels
BACKEND_LOG_LEVEL=info
EDGE_LOG_LEVEL=info

# Performance Test Configuration
# Set this after running populate_perf_test_data.js
ENVIRONMENT_ID=

# k6 Test Configuration
TOTAL_FEATURES=1000000
TARGET_RPS=1000
P95_THRESHOLD=500
P99_THRESHOLD=1000
ERROR_RATE_THRESHOLD=0.01
